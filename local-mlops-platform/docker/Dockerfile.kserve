# KServe serving image: bakes the trained model and serves the KServe V1
# dataplane via FastAPI/uvicorn. Build AFTER training so models/model.joblib
# exists in the build context.
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY requirements.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
RUN /opt/venv/bin/pip install --no-deps -e .

# ---- runtime ----
FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MODEL_DIR=/app/models \
    PORT=8080

RUN groupadd --system app && useradd --system --gid app --home /app app
WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app pyproject.toml README.md ./
COPY --chown=app:app src ./src
# Baked-in trained model artifact (produced by `make train`).
COPY --chown=app:app models ./models

USER app
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8080/healthz'); sys.exit(0)" || exit 1

CMD ["sh", "-c", "uvicorn mlops_demo.serve:app --host 0.0.0.0 --port ${PORT}"]
