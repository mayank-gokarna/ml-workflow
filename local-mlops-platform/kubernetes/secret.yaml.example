# EXAMPLE ONLY — copy to secret.yaml, fill real values, and DO NOT commit it.
# secret.yaml is git-ignored. Apply with: kubectl apply -f secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: mlops-demo-secrets
  namespace: mlops
  labels:
    app.kubernetes.io/part-of: local-mlops-platform
type: Opaque
stringData:
  # Placeholders — replace locally. Never commit real credentials.
  MLFLOW_TRACKING_USERNAME: "changeme"
  MLFLOW_TRACKING_PASSWORD: "changeme"
